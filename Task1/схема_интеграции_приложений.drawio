        <mxCell id="hRlU7DsKugaUehmcTT7V-85" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;strong style=&quot;font-size: 12px;&quot;&gt;Депозитный процесс (шаги 1-14):&lt;/strong&gt;&lt;/h1&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;Звонок клиента в кол-центр&lt;br&gt;2-3. Обработка обращения и передача в АБС&lt;br&gt;4-5. Получение ставки ЦБ и расчет в Excel&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;Передача ставок в отделения по email&lt;br&gt;7-10. Согласование спецставок по email&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;Открытие депозита в АБС&lt;br&gt;12-14. Отправка СМС клиенту&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360" y="360" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="hRlU7DsKugaUehmcTT7V-86" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;strong style=&quot;font-size: 12px;&quot;&gt;Кредитный процесс (шаги 15-23):&lt;/strong&gt;&lt;/h1&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;15-16. Подача заявки в отделении&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;17. Ночной batch в кредитный конвейер&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;18-20. Скоринг с проверкой в БКИ&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;21. Обработка кредитным специалистом&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;22. Возврат решения в АБС (batch)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;23. Зачисление средств&lt;/span&gt;&lt;/blockquote&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360" y="590" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="hRlU7DsKugaUehmcTT7V-87" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;strong style=&quot;font-size: 12px;&quot;&gt;Ключевые проблемы:&lt;/strong&gt;&lt;/h1&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Красный цвет (email)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; - Ручные процессы, задержки.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Пунктирные batch-связи&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; - Задержки в обработке (раз в сутки).&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Excel как &quot;система&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; расчета ставок.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Клиент не видит&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; онлайн-статус своих заявок.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360" y="780" width="340" height="130" as="geometry" />
        </mxCell>
      </root>
